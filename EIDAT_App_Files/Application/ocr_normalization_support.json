    "Add aliases for common OCR variants (e.g., psig vs psi(g), degC vs °C)."
  ],
  "special_symbols": {
    "degree": ["°", "º", "˚"],
    "micro": ["µ", "μ"],
    "plus_minus": ["±"],
    "times": ["×", "x"],
    "dot": ["·", "•"]
  },
