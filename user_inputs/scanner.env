# Scanner configuration (session-scoped). Use KEY=VALUE.
# Blank lines and lines starting with # or ; are ignored.

# ---------------------------------------------------------------------------
# Python/venv (optional)
# If you keep the venv outside the repo, set VENV_DIR so run.bat uses it.
#VENV_DIR=C:\Path\To\PDF_Scanner.venv

# Optional: add a local site-packages folder if you vendor wheels into the repo
#PYTHONPATH=C:\Users\zachs\Documents\DevProjects\PDF_Scanner\Lib\site-packages;%PYTHONPATH%

# ---------------------------------------------------------------------------
# OCR behavior (EasyOCR-only, on-demand)
# We do NOT use external OCR tools (Tesseract/OCRmyPDF/Poppler/Paddle).
USE_OCRMYPDF=off            # keep off; no external pre-OCR passes
OCR_RENDERER=easyocr        # core will use EasyOCR only when needed
USE_EASYOCR_XY=1            # let the core invoke EasyOCR on-demand for table(xy)

# Only set FORCE_OCR=1 if you want to force OCR for all requested pages
# (generally leave this off so text-first is attempted across the range).
FORCE_OCR=1

# EasyOCR tuning
OCR_DPI=800                 # 600 is fast/good; use 800 for tiny fonts
EASYOCR_LANGS=en            # comma/semicolon list
XY_FUZZ=0.7                # 0..1; higher is stricter header/row fuzzy match
ROW_BAND=0.6                # vertical band around the matched row (relative to row height)
COL_TOL=1.0                 # horizontal tolerance around header center (relative to header width)
XY_LOG=1
