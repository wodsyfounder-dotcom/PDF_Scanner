# Scanner configuration (session-scoped). Lines of the form KEY=VALUE.
# Blank lines and lines starting with # or ; are ignored.

# --- OCRmyPDF controls ---
#Enable OCRmyPDF pre-processing: primary (pre-OCR entire doc) or fallback (truthy).
USE_OCRMYPDF=primary

# Do not force OCR of pages that already contain text (set to 0). Default is force.
#OCRMYPDF_FORCE=0

# Language and optimizSation level (0..3). Higher levels may require external tools (pngquant).
OCRMYPDF_LANG=eng
OCRMYPDF_OPTIMIZE=1

# Keep temporary OCR’d PDFs for debugging (1=true).
#OCRMYPDF_KEEP=0

# --- Direct Tesseract OCR controls (when used) ---
#OCR_RENDERER=pymupdf
#OCR_DPI=400
#TESSERACT_ARGS=--psm 6

# Optional paths for tools if not on PATH
#TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
OCRMYPDF_BIN=C:\Users\zachs\Desktop\PDF_Scanner.venv\Scripts\ocrmypdf.exe

